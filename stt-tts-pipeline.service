[Unit]
Description=STT-TTS Pipeline API Service
After=network.target

[Service]
Type=simple
User=vx
WorkingDirectory=/opt/hash-pbx
Environment="PATH=/opt/hash-pbx/.venv/bin"
EnvironmentFile=/opt/hash-pbx/.env
ExecStart=/opt/hash-pbx/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stt-tts-pipeline

[Install]
WantedBy=multi-user.target
