# ── Sunbird AI ────────────────────────────────────────────────────────────
# Required for: Sunbird TTS voices (48 speakers, 17 languages) and the Sunbird
# STT backend (51 African languages). English (Kokoro) and Swahili (edge-tts)
# TTS, plus the local faster-whisper STT backend, all work without this.
# AUTH_TOKEN=your_sunbird_ai_bearer_token_here

# ── Speech-to-text ───────────────────────────────────────────────────────
# faster-whisper size: tiny | base | small | medium | large-v3  (default: base)
# WHISPER_MODEL=base

# Optional — enables the OpenAI Whisper API STT backend.
# OPENAI_API_KEY=sk-...
